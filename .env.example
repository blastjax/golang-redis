# Copy to .env and adjust. The values shown are the defaults.
# docker compose reads DB_USER, DB_NAME, DB_PORT and REDIS_PORT from .env too.

# PostgreSQL. The compose.yaml database trusts local connections, so no password is needed.
# For a hosted database that requires TLS, also set PGSSLMODE=require.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=github_users
DB_MAX_CONNECTIONS=10
DB_MAX_IDLE_CONNECTIONS=5

# GitHub API. A token (no scopes needed) raises the rate limit from 60 to 5,000 requests per hour.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28

# Redis. GET /users/:username caches results for REDIS_TTL_SECONDS.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SECONDS=30

# REST API server
API_HOST=localhost
API_PORT=8080

# "production" switches Gin to release mode
APP_ENV=development
